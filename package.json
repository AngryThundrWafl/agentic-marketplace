{
  "name": "agentic-marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:plugins": "node --experimental-strip-types build/validate-plugins.ts",
    "build": "node --experimental-strip-types build/cli.ts",
    "release-gate": "corepack pnpm typecheck && corepack pnpm test && corepack pnpm validate:plugins && corepack pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4",
    "yaml": "^2.9.1"
  }
}
