{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-marketplace.local/schemas/internal/compatibility.schema.json",
  "title": "Target Compatibility & Loss Report (compatibility.json)",
  "description": "Machine-readable compatibility and translation loss report emitted into dist/<plugin>/<target>/compatibility.json.",
  "type": "object",
  "required": [
    "plugin",
    "target",
    "packageFormat",
    "adapterVersion",
    "capabilityRegistryVersion",
    "provenance",
    "emitted",
    "omitted",
    "rewrittenFeatures",
    "dependencies",
    "nativeExtensions",
    "unsupportedFunctionality",
    "securityWarnings"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "plugin": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+\\.[a-z0-9-]+$"
    },
    "packageFormat": {
      "type": "string",
      "minLength": 1
    },
    "adapterVersion": {
      "type": "string",
      "minLength": 1
    },
    "capabilityRegistryVersion": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": ["sourceCommit", "buildId"],
      "additionalProperties": false,
      "properties": {
        "sourceCommit": { "type": "string", "minLength": 1 },
        "buildId": { "type": "string", "minLength": 1 }
      }
    },
    "emitted": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "adapterVersion"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["exact", "equivalent", "partial"]
          },
          "adapterVersion": { "type": "string", "minLength": 1 },
          "equivalenceTest": { "type": "string" },
          "omittedFeatures": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "omitted": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reason", "optional"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "optional": { "type": "boolean" }
        }
      }
    },
    "rewrittenFeatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["componentId", "feature", "from", "to"],
        "additionalProperties": false,
        "properties": {
          "componentId": { "type": "string", "minLength": 1 },
          "feature": { "type": "string", "minLength": 1 },
          "from": { "type": "string" },
          "to": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "required", "resolved"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "resolved": { "type": "boolean" }
        }
      }
    },
    "nativeExtensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "version"],
        "additionalProperties": false,
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unsupportedFunctionality": {
      "type": "array",
      "items": { "type": "string" }
    },
    "securityWarnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
