{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-marketplace.local/schemas/internal/meta.schema.json",
  "title": "Internal Plugin Metadata (meta.json)",
  "description": "Repo-internal metadata for a plugin under plugins/<plugin-name>/meta.json. Never shipped inside agent-plugin/.",
  "type": "object",
  "required": ["targets", "components"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "developmentOnly": {
      "type": "boolean",
      "default": false
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "packageFormat"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+\\.[a-z0-9-]+$"
          },
          "minVersion": {
            "type": "string",
            "minLength": 1
          },
          "packageFormat": {
            "type": "string",
            "enum": [
              "agent-plugins-1.0",
              "claude-native",
              "cursor-native",
              "codex-native",
              "antigravity-native",
              "opencode-native",
              "pi-package"
            ]
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source", "optional", "translations"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+:(skill|mcp-server|agent|command|rule|hook|native-override):[a-z0-9-]+$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "optional": {
            "type": "boolean"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "name"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["runtime", "tool", "mcp-server", "plugin", "component"]
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "versionConstraint": {
                  "type": "string"
                }
              }
            }
          },
          "omittedFeatures": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "translations": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": ["exact", "equivalent", "partial", "unsupported", "unsafe"]
            }
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skillDescriptionMaxChars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      }
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "required", "provisioning"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "provisioning": {
            "type": "string",
            "enum": ["target-secret-store", "env", "oauth", "interactive"]
          },
          "server": {
            "type": "string"
          }
        }
      }
    },
    "reviewedAlternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["adr", "reviewer", "date", "alternative"],
        "additionalProperties": false,
        "properties": {
          "adr": {
            "type": "string",
            "minLength": 1
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "alternative": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
